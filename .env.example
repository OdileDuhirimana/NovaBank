# Runtime
PORT=8080

# Spring profile: dev | staging | prod (see application-{profile}.yml). BootstrapConfig only
# tolerates a missing APP_BOOTSTRAP_ADMIN_PASSWORD when this is "dev" or "local".
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL (also consumed directly by docker-compose.yml for the nova-bank-db container)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nova_bank
DB_USER=postgres
DB_PASSWORD=postgres
POSTGRES_DB=nova_bank
POSTGRES_USER=nova_user
# Required by docker-compose.yml — pick your own local-only value, never reuse across environments.
POSTGRES_PASSWORD=change-me-locally

# JWT (access token)
# Must be a Base64-encoded string that decodes to at least 32 bytes
# Generate one: openssl rand -base64 32
SECURITY_JWT_SECRET=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# Short-lived on purpose (15 min default) — a leaked access token has a small blast radius.
# See SECURITY_JWT_REFRESH_EXPIRATION_MS for the longer-lived, server-revocable refresh token.
SECURITY_JWT_EXPIRATION_MS=900000
SECURITY_JWT_REFRESH_EXPIRATION_MS=604800000

# Default ADMIN bootstrap account (see BootstrapConfig). REQUIRED (application refuses to start)
# unless SPRING_PROFILES_ACTIVE is "dev" or "local", in which case a random password is
# generated and logged instead. Always set this explicitly for any shared/production deployment.
APP_BOOTSTRAP_ADMIN_PASSWORD=

# Optional webhook notifications (dispatched asynchronously via the outbox pattern — see
# WebhookOutboxService/WebhookDispatcher — never synchronously inside a transfer request)
APP_NOTIFICATIONS_WEBHOOK_ENABLED=false
APP_NOTIFICATIONS_WEBHOOK_URL=
APP_NOTIFICATIONS_WEBHOOK_API_KEY=

# Optional distributed tracing (Micrometer Tracing + Brave + Zipkin reporter). Unverified against
# a live collector in this environment — see README "Observability" section.
MANAGEMENT_ZIPKIN_TRACING_ENDPOINT=http://localhost:9411/api/v2/spans
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=1.0
