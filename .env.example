# Runtime
PORT=8080

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nova_bank
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
# Must be a Base64-encoded string that decodes to at least 32 bytes
# Generate one: openssl rand -base64 32
SECURITY_JWT_SECRET=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
SECURITY_JWT_EXPIRATION_MS=86400000

# Optional webhook notifications
APP_NOTIFICATIONS_WEBHOOK_ENABLED=false
APP_NOTIFICATIONS_WEBHOOK_URL=
APP_NOTIFICATIONS_WEBHOOK_API_KEY=
